# RT-AC68U-class target: ARMv7-A Cortex-A9 with a software-float user ABI.
# The armv5 artifact/package label is retained for the existing release
# archive contract; this guest is deliberately not an ARMv5 CPU.
# CONFIG_ARCH_MULTI_V5 is not set
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_VEXPRESS=y
CONFIG_MFD_VEXPRESS_SYSREG=y
CONFIG_CLK_SP810=y
CONFIG_CLK_VEXPRESS_OSC=y
CONFIG_AEABI=y
CONFIG_ARM_THUMB=y
# The guest CPU and userland must not expose or require VFP/NEON.
# CONFIG_VFP is not set
CONFIG_CPU_V7=y
# CONFIG_NEON is not set
# CONFIG_SMP is not set
CONFIG_KUSER_HELPERS=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_ARM_VIC=y
CONFIG_ARM_TIMER_SP804=y
